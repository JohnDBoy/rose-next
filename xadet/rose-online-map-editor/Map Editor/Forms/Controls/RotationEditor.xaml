<UserControl x:Class="Map_Editor.Forms.Controls.RotationEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    SnapsToDevicePixels="True">
    <Grid Background="White" Margin="8,6,8,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="26" />
            <RowDefinition Height="26" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- The degree fields are WinForms boxes: the XNA loop pumps this window's
             messages and WPF text boxes get no keystrokes in it. -->
        <Label Grid.Row="0" Grid.Column="0" Padding="0" VerticalAlignment="Center" ToolTip="Heading, about the vertical axis">Yaw</Label>
        <Slider Grid.Row="0" Grid.Column="1" x:FieldModifier="public" Name="YawSlider" Minimum="-180" Maximum="180" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="Slider_ValueChanged" PreviewMouseUp="Slider_PreviewMouseUp" PreviewKeyUp="Slider_PreviewKeyUp" />
        <WindowsFormsHost Grid.Row="0" Grid.Column="2" Name="YawHost" Height="20" ToolTip="Degrees; Enter applies">
            <wf:TextBox Dock="Fill" TextAlign="Right" />
        </WindowsFormsHost>

        <Label Grid.Row="1" Grid.Column="0" Padding="0" VerticalAlignment="Center" ToolTip="Tilt forward or back, about X">Pitch</Label>
        <Slider Grid.Row="1" Grid.Column="1" Name="PitchSlider" Minimum="-180" Maximum="180" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="Slider_ValueChanged" PreviewMouseUp="Slider_PreviewMouseUp" PreviewKeyUp="Slider_PreviewKeyUp" />
        <WindowsFormsHost Grid.Row="1" Grid.Column="2" Name="PitchHost" Height="20" ToolTip="Degrees; Enter applies">
            <wf:TextBox Dock="Fill" TextAlign="Right" />
        </WindowsFormsHost>

        <Label Grid.Row="2" Grid.Column="0" Padding="0" VerticalAlignment="Center" ToolTip="Tilt sideways, about Y">Roll</Label>
        <Slider Grid.Row="2" Grid.Column="1" Name="RollSlider" Minimum="-180" Maximum="180" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="Slider_ValueChanged" PreviewMouseUp="Slider_PreviewMouseUp" PreviewKeyUp="Slider_PreviewKeyUp" />
        <WindowsFormsHost Grid.Row="2" Grid.Column="2" Name="RollHost" Height="20" ToolTip="Degrees; Enter applies">
            <wf:TextBox Dock="Fill" TextAlign="Right" />
        </WindowsFormsHost>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Padding="0" VerticalAlignment="Center" Margin="0,0,6,0">Yaw snap</Label>
            <ComboBox x:FieldModifier="public" Name="SnapCombo" Width="64" Height="20" SelectionChanged="SnapCombo_SelectionChanged" ToolTip="Yaw steps for the slider and for the mouse wheel while placing">
                <ComboBoxItem>Off</ComboBoxItem>
                <ComboBoxItem>15°</ComboBoxItem>
                <ComboBoxItem>45°</ComboBoxItem>
                <ComboBoxItem>90°</ComboBoxItem>
            </ComboBox>
            <Button Name="ResetButton" Margin="10,0,0,0" Width="44" Height="20" Padding="0" Click="Reset_Click" ToolTip="Set every angle to 0">Reset</Button>
        </StackPanel>
    </Grid>
</UserControl>
