[database]
connection_string = "postgres://postgres:postgres@localhost/rose-next"

[loginserver]
ip = "127.0.0.1"
port = 29000
server_port = 19000
password = "password"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\loginserver.log"
minimum_access_level = 1
max_users = 0

[worldserver]
ip = "127.0.0.1"
port = 29100
server_port = 19001
world_name = "1Rose Next" # Prepend number to control ordering in world list
data_dir = "C:\\rose-next\\server\\data"
clanmark_dir = "C:\\rose-next\\server\\data\\clanmark"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\worldserver.log"

[gameserver]
ip = "127.0.0.1"
port = 29200
server_name = "Channel 1"
data_dir = "C:\\rose-next\\server\\data"
log_level = 0
log_path = "C:\\rose-next\\server\\logs\\gameserver.log"

[game]
base_move_speed = 200
base_attack_power = 0
base_attack_speed = 0
base_hit = 0
base_crit = 0
# Height rules (doc/pathfinding-and-z-plan.md, Phase 3). Every key is optional: these are the
# defaults. Needs the zone walk grids (scripts/nav-bake.py); a zone without one stays 2D.
# GMs can change them live with /nav set.
[nav]
aoe_vertical = 1        # 0 = 2D as before, 1 = band, 2 = sphere, 3 = cylinder
aoe_band_base_cm = 500  # band: a target may be this far above or below the centre...
aoe_band_slope_pct = 70 # ...plus this % of its horizontal distance from it
mob_layer_aggro = 1     # monster aggro and help calls use the same rule
spawn_roofs = 1         # re-roll a regen spawn the client would draw on a roof
ai_walls = 1            # idle walks (wander, flee, leash, summon follow) walk their line on the grid
spawn_reach = 1         # re-roll a regen spawn behind a wall or off the walkable ground
